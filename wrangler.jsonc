{
  "name": "usage-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-10",
  "account_id": "07313d620ec2c3009fe37e942d5dd0f8",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
